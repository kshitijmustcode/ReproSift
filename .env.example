# API settings implemented in Step 5. Defaults allow local startup without a file.
# To load a copy explicitly from the repository root:
# uv run --project services/backend --locked reprosift-api --env-file .env
# Process environment overrides file values. Never commit real secrets.
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=info

# Dashboard server setting implemented in Step 9. It stays server-side and defaults to this URL.
REPROSIFT_API_URL=http://127.0.0.1:8000

# Local demo-store fixture setting implemented in Step 11. It is server-side and defaults to buggy.
DEMO_STORE_VARIANT=buggy

# Step 16 persistence setting. PostgreSQL is the deployed target; SQLite keeps local setup self-contained.
DATABASE_URL=sqlite:///./reprosift.db

# Step 18 model-provider settings. Keep the key server-side; a model request fails safely when absent.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_MAX_OUTPUT_TOKENS=1000
OPENAI_MAX_TOTAL_TOKENS_PER_RUN=60000

# Proposed settings below are not consumed or validated yet.
# Empty required credentials must fail when their owning feature is implemented.
NODE_ENV=development
DASHBOARD_PORT=3000
DEMO_STORE_PORT=3001
DEMO_STORE_BASE_URL=http://localhost:3001
ALLOWED_TARGET_ORIGINS=http://localhost:3001
# Add only the exact internal demo-store origin for Docker networking.
OPENAI_EMBEDDING_MODEL=
REDIS_URL=
JOB_BACKEND=celery
MCP_TRANSPORT=stdio
# The Python MCP client launches this compiled TypeScript stdio entry point.
MCP_NODE_COMMAND=node
MCP_SERVER_ENTRYPOINT=packages/mcp-server/dist/cli.js
MCP_CONNECT_TIMEOUT_MS=5000
MCP_CALL_TIMEOUT_MS=5000
# Required when a separate browser MCP server uses streamable HTTP.
BROWSER_MCP_URL=
ARTIFACT_BACKEND=local
ARTIFACT_DIRECTORY=./artifacts
ARTIFACT_RETENTION_DAYS=7
MAX_ACTIVE_INVESTIGATIONS=1
MAX_PUBLIC_INVESTIGATIONS_PER_DAY=5
RUN_TIMEOUT_MS=300000
ACTION_TIMEOUT_MS=10000
MAX_TOOL_CALLS_PER_RUN=30
MAX_MODEL_CALLS_PER_RUN=15
REPLAY_COUNT=3
# Trusted harness only; do not expose to browser clients or models.
DEMO_RESET_SECRET=
# Required only when remote authenticated MCP is enabled.
MCP_AUTH_SECRET=
