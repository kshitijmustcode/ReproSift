{
  "name": "reprosift",
  "version": "0.0.0",
  "private": true,
  "description": "Evidence-backed UI bug reproduction and verification",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "format": "pnpm format:js && pnpm format:python",
    "format:js": "prettier --write .",
    "format:python": "uv run --directory services/backend --locked ruff format",
    "format:check": "pnpm format:js:check && pnpm format:python:check",
    "format:js:check": "prettier --check .",
    "format:python:check": "uv run --directory services/backend --locked ruff format --check",
    "lint": "pnpm lint:js && pnpm lint:python",
    "lint:js": "eslint . --max-warnings 0",
    "lint:python": "uv run --directory services/backend --locked ruff check",
    "typecheck": "pnpm typecheck:js && pnpm typecheck:python",
    "typecheck:js": "pnpm typecheck:dashboard && pnpm typecheck:store && pnpm typecheck:browser-runner && pnpm typecheck:mcp",
    "typecheck:python": "uv run --directory services/backend --locked mypy",
    "test": "pnpm test:js && pnpm test:python",
    "test:js": "pnpm build:mcp && vitest run",
    "test:python": "pnpm build:mcp && uv run --directory services/backend --locked pytest",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "dev:dashboard": "pnpm --filter @reprosift/dashboard dev",
    "build:dashboard": "pnpm --filter @reprosift/dashboard build",
    "typecheck:dashboard": "pnpm --filter @reprosift/dashboard typecheck",
    "dev:store": "pnpm --filter @reprosift/demo-store dev",
    "build:store": "pnpm --filter @reprosift/demo-store build",
    "typecheck:store": "pnpm --filter @reprosift/demo-store typecheck",
    "build:mcp": "pnpm --filter @reprosift/browser-runner build && pnpm --filter @reprosift/mcp-server build",
    "typecheck:browser-runner": "pnpm --filter @reprosift/browser-runner typecheck",
    "typecheck:mcp": "pnpm --filter @reprosift/mcp-server typecheck",
    "smoke:mcp": "pnpm --filter @reprosift/mcp-server smoke"
  },
  "devDependencies": {
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.6",
    "vitest": "5.0.0"
  },
  "engines": {
    "node": ">=24.21.0 <25",
    "pnpm": "11.19.0"
  }
}
